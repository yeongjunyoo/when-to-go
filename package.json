{
  "name": "when-to-go",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "web",
    "worker"
  ],
  "scripts": {
    "build": "npm run build --workspace=worker && npm run build --workspace=web",
    "check:terms": "node scripts/check-forbidden-terms.mjs",
    "check:fixtures": "node scripts/check-no-prod-fixtures.mjs",
    "test": "vitest run",
    "dev:web": "npm run dev --workspace=web",
    "dev:worker": "npm run dev --workspace=worker"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260826.1": true
  }
}
